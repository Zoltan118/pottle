# which wallet sign-in to use: circle (circle email wallets) or dynamic. defaults to dynamic
NEXT_PUBLIC_WALLET_PROVIDER=circle

# circle user-controlled wallets (email codes). console.circle.com:
#   app id: wallets > user controlled > configurator. public, safe in the browser
#   the server api key is CIRCLE_API_KEY below. never expose it
#   email codes need smtp configured in the same configurator (authentication methods > email otp)
NEXT_PUBLIC_CIRCLE_APP_ID=

# dynamic, only when NEXT_PUBLIC_WALLET_PROVIDER=dynamic. public id from app.dynamic.xyz > developers > sdk & api keys
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# testnet or mainnet
NEXT_PUBLIC_ARC_NETWORK=testnet

# the deployed Pottle contract on that network (see ../contracts/README.md)
NEXT_PUBLIC_POTTLE_ADDRESS=

# optional, server only. a funded arc key that pays network fees so friends only sign.
# leave empty and each person pays their own fee from their wallet instead.
RELAYER_PRIVATE_KEY=

# server only. circle api key (console.circle.com > keys). used for circle email wallets, and on
# testnet to refill the relayer from circle's faucet api (that part needs a mainnet-upgraded account)
CIRCLE_API_KEY=

# optional: circle onramp kit, lets people buy usdc straight into their wallet.
# kit key from https://console.circle.com/api-keys (a sandbox key only works with the sandbox urls)
ONRAMP_API_KEY=
# sandbox: https://api-test.circle.com  production: leave empty
ONRAMP_API_BASE_URL=
# sandbox: https://onramp-sandbox.arc.io  production: leave empty. setting this shows the "add money" button
NEXT_PUBLIC_ONRAMP_WIDGET_BASE_URL=
# the hostname the app is served from, e.g. pottle-1.vercel.app, so circle's widget may load inside it
ONRAMP_REFERRER_DOMAIN=

# the scheduled settle job (github actions) calls /api/cron/settle with this as a bearer token.
# any long random string; set the same value as a github repository secret
CRON_SECRET=

# optional: the public address of this site, e.g. https://pottle.money. used for link previews,
# robots.txt and the sitemap. on vercel it defaults to the project's production address
NEXT_PUBLIC_SITE_URL=

# optional: the same app on the other network, linked from the footer
# (on mainnet: the free testnet site. on testnet: the real one)
NEXT_PUBLIC_OTHER_SITE_URL=
