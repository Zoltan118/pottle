# public id from app.dynamic.xyz > developers > sdk & api keys. enables email sign-in.
# testnet site: the sandbox environment is fine. mainnet site (real money): use dynamic's LIVE
# environment. sandbox is for development, its limits and guarantees are not meant for real users
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# testnet or mainnet. required on a live vercel deployment: unset there shows "not set up"
NEXT_PUBLIC_ARC_NETWORK=testnet

# optional, server only: an arc rpc of your own (a provider url, often with a key in it). the settle job
# and the relayer try it first and fall back to arc's public rpc. keep it out of the repo
ARC_RPC_URL=

# the deployed Pottle contract on that network (see ../contracts/README.md)
NEXT_PUBLIC_POTTLE_ADDRESS=

# optional, server only. a funded arc key that pays network fees so friends only sign.
# leave empty and each person pays their own fee from their wallet instead.
RELAYER_PRIVATE_KEY=

# optional, server only, testnet. a circle api key from a mainnet-upgraded account.
# when the relayer runs low, the drip asks circle's faucet api to refill it.
CIRCLE_API_KEY=

# optional: circle onramp kit, lets people buy usdc straight into their wallet.
# the api key from https://console.circle.com, pasted whole: TEST_API_KEY:... for the sandbox, LIVE_API_KEY:...
# for production. the key picks the environment
ONRAMP_API_KEY=
# leave empty: the kit talks to https://api.circle.com for both sandbox and production (a sandbox key
# pointed at another host is refused as an invalid key)
ONRAMP_API_BASE_URL=
# sandbox: https://onramp-sandbox.arc.io  production: https://onramp.arc.io (with a production kit key).
# leave empty to hide card payments. on mainnet a sandbox url is ignored, so test money is never sold
NEXT_PUBLIC_ONRAMP_WIDGET_BASE_URL=
# the hostname the app is served from, e.g. pottle.xyz (test.pottle.xyz on the testnet site), so circle's widget may load inside it
ONRAMP_REFERRER_DOMAIN=

# the scheduled settle job (github actions) calls /api/cron/settle with this as a bearer token.
# any long random string, different for each site. set it as the github repository secret CRON_SECRET
# (mainnet site) or CRON_SECRET_TESTNET (testnet site), see .github/workflows/settle.yml
CRON_SECRET=

# signs pot links (lib/potLink.ts): a pot opens on pottle only from its full link, /p/<id>-<code>.
# any long random string (openssl rand -hex 32), different for each site. keep it once set: changing it
# breaks every pot link already shared. without it, pot pages and new pot links are off
POT_LINK_SECRET=

# optional: google analytics measurement id (G-...). set it only on the sites that should report.
# it runs with consent denied: no cookies, no ad features, cookieless page views only
NEXT_PUBLIC_GA_ID=

# optional: the public address of this site, e.g. https://pottle.xyz. used for link previews,
# robots.txt and the sitemap. on vercel it defaults to the project's production address
NEXT_PUBLIC_SITE_URL=

# optional: the same app on the other network. shows the live | test switch in the nav and the
# footer link (on mainnet: the free testnet site. on testnet: the live one)
NEXT_PUBLIC_OTHER_SITE_URL=


# optional: the published whatsapp sticker pack link (for example a sticker.ly pack). without it, /stickers offers the files
NEXT_PUBLIC_STICKER_PACK_URL=
